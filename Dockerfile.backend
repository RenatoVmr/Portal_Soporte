FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY backend/SupportPortal.Api.csproj backend/
WORKDIR /src/backend

COPY backend/ ./
RUN dotnet publish SupportPortal.Api.csproj \
    --configuration Release \
    --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app/publish ./

ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
CMD ["sh", "-c", "dotnet SupportPortal.Api.dll --urls http://0.0.0.0:${PORT:-8080}"]
